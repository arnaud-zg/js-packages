                              "required": [
                                "use"
                              ],
                              "properties": {
                                "use": {
                                  "anyOf": [
                                    {
                                      "const": "git",
                                      "description": "Branches, commits and tags, through the git CLI"
                                    }
                                  ]
                                },
                                "with": {
                                  "type": "object"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "use": {
                                        "const": "git"
                                      }
                                    },
                                    "required": [
                                      "use"
                                    ]
                                  },
                                  "then": {
                                    "properties": {
                                      "with": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                          "main": {
                                            "description": "The branch releases start from; origin's default branch, main or master, when absent",
                                            "type": "string"
                                          },
                                          "format": {
                                            "description": "Run on the files of a commit before it is made, such as a formatter",
                                            "type": "array",
                                            "items": {
                                              "type": "string"
                                            }
                                          },
                                          "retryDelays": {
                                            "description": "How long to wait before each new try of a push the network dropped, in ms",
                                            "type": "array",
                                            "items": {
                                              "type": "number"
