                  "properties": {
                    "with": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "description": "What an app's unit file names; the module's kind by default",
                          "type": "string"
                        },
                        "staticHosting": {
                          "description": "The staticHosting adapter: a name, or use: the name with with: its options",
                          "anyOf": [
                            {
                              "const": "cloudflare-pages",
                              "description": "Deploys each site to Cloudflare Pages, through wrangler"
                            },
                            {
                              "const": "github-pages",
                              "description": "Deploys each site to GitHub Pages, through a branch"
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "use"
                              ],
                              "properties": {
                                "use": {
                                  "anyOf": [
                                    {
                                      "const": "cloudflare-pages",
                                      "description": "Deploys each site to Cloudflare Pages, through wrangler"
                                    },
                                    {
                                      "const": "github-pages",
                                      "description": "Deploys each site to GitHub Pages, through a branch"
                                    }
                                  ]
                                },
                                "with": {
                                  "type": "object"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "use": {
                                        "const": "cloudflare-pages"
                                      }
                                    },
                                    "required": [
                                      "use"
                                    ]
                                  },
                                  "then": {
                                    "properties": {
                                      "with": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {},
                                        "required": []
                                      }
                                    }
                                  }
                                },
                                {
                                  "if": {
                                    "properties": {
                                      "use": {
                                        "const": "github-pages"
                                      }
                                    },
                                    "required": [
                                      "use"
                                    ]
                                  },
                                  "then": {
                                    "properties": {
                                      "with": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {},
                                        "required": []
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "staticHosting"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "use": {
                      "const": "mobile-app"
                    }
                  },
                  "required": [
                    "use"
                  ]
                },
                "then": {
                  "required": [
                    "with"
