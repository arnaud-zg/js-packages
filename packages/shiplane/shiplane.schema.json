                              "properties": {
                                "use": {
                                  "anyOf": [
                                    {
                                      "const": "eas",
                                      "description": "Builds, submits and updates each app with Expo Application Services"
                                    }
                                  ]
                                },
                                "with": {
                                  "type": "object"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "use": {
                                        "const": "eas"
                                      }
                                    },
                                    "required": [
                                      "use"
                                    ]
                                  },
                                  "then": {
                                    "properties": {
                                      "with": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {},
                                        "required": []
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      },
                      "required": [
                        "mobileDistribution"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "use": {
                      "const": "published-package"
                    }
                  },
                  "required": [
                    "use"
                  ]
                },
                "then": {
                  "required": [
                    "with"
                  ],
                  "properties": {
                    "with": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "description": "What an app's unit file names; the module's kind by default",
                          "type": "string"
                        },
                        "packageRegistry": {
                          "description": "The packageRegistry adapter: a name, or use: the name with with: its options",
                          "anyOf": [
                            {
                              "const": "npm",
                              "description": "Publishes each package to npm, under its own dist-tag"
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "use"
                              ],
                              "properties": {
                                "use": {
                                  "anyOf": [
                                    {
                                      "const": "npm",
                                      "description": "Publishes each package to npm, under its own dist-tag"
                                    }
                                  ]
                                },
                                "with": {
                                  "type": "object"
                                }
                              },
                              "allOf": [
                                {
                                  "if": {
                                    "properties": {
                                      "use": {
                                        "const": "npm"
