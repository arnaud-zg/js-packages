    "tag": {
      "description": "How a tag names a version: a format's name, or a format of your own naming {version}.",
      "anyOf": [
        {
          "enum": [
            "package",
            "plugin",
            "single",
            "module"
          ]
        },
        {
          "type": "string",
          "pattern": "\\{version\\}"
        }
      ]
    },
    "via": {
      "description": "How a unit ships when both ways can: ci (the flow's CI pipeline) or local (this machine).",
      "enum": [
        "ci",
        "local"
      ]
    },
    "display": {
      "description": "How much the release says while it runs; --verbose and --mascot override.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbose": {
          "type": "boolean",
          "description": "Say each thing it reads and runs, with a progress bar."
        },
        "mascot": {
          "description": "The mascot beside what is happening: true, false, or frames per mood.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "deployApps": {
      "description": "How deployed apps reach their users: a release deploys to from, a promote takes it to to. Not for packages.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promote"
      ],
      "properties": {
        "promote": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "from": {
                "enum": [
                  "preview"
                ]
              },
              "to": {
                "enum": [
                  "production"
                ]
              }
            }
          }
        }
      }
    },
    "publishPackages": {
      "description": "How packages are published: channels, from the earliest to live, and onBranch, what any branch may publish. Not for apps, nor internal packages.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "onBranch": {
          "enum": [
            "snapshot",
            false
          ]
        }
      }
    },
    "testComment": {
      "description": "The pull request comment of a test version: a preset's name, or a template with {branch}, {commit}, {table} and {install}.",
      "anyOf": [
        {
          "enum": [
            "table",
            "compact"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "testRelease": {
      "description": "Which channel each branch's test release publishes on: a preset's name, or a map of branch to channel.",
      "anyOf": [
        {
          "enum": [
            "nightly",
            "prerelease",
            "gitflow"
          ]
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "prepare": {
      "type": "string",
      "description": "A shell command run from the root before each unit ships from this machine; {unit} and {dir} are filled."
    }
  }
}
